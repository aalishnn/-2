using System;

public interface IReport
{
    string Generate();
}

// Базовые отчеты
public class SalesReport : IReport
{
    public string Generate()
    {
        return "Sales: [100, 200, 300]";
    }
}

public class UserReport : IReport
{
    public string Generate()
    {
        return "Users: [Ali, Dana, John]";
    }
}

// Абстрактный декоратор
public abstract class ReportDecorator : IReport
{
    protected IReport report;

    public ReportDecorator(IReport report)
    {
        this.report = report;
    }

    public virtual string Generate()
    {
        return report.Generate();
    }
}

// Фильтр по датам
public class DateFilterDecorator : ReportDecorator
{
    public DateFilterDecorator(IReport report) : base(report) { }

    public override string Generate()
    {
        return base.Generate() + " | Filtered by date";
    }
}

// Сортировка
public class SortingDecorator : ReportDecorator
{
    public SortingDecorator(IReport report) : base(report) { }

    public override string Generate()
    {
        return base.Generate() + " | Sorted";
    }
}

// Фильтр по сумме
public class AmountFilterDecorator : ReportDecorator
{
    public AmountFilterDecorator(IReport report) : base(report) { }

    public override string Generate()
    {
        return base.Generate() + " | Filtered by amount";
    }
}

// CSV экспорт
public class CsvExportDecorator : ReportDecorator
